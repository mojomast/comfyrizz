{
  "contract": "comfyrizz.save-state/v1",
  "valid": [
    { "name": "fresh document, server session, nothing saved yet",
      "state": { "status": "pending", "editSequence": 0, "acknowledgedSequence": 0, "acknowledgedRevision": null, "currentRevision": null, "error": null },
      "serverSaved": false },
    { "name": "server acknowledged the newest edit",
      "state": { "status": "saved", "editSequence": 4, "acknowledgedSequence": 4, "acknowledgedRevision": 7, "currentRevision": null, "error": null },
      "serverSaved": true },
    { "name": "edit in flight after an earlier ack",
      "state": { "status": "pending", "editSequence": 5, "acknowledgedSequence": 4, "acknowledgedRevision": 7, "currentRevision": null, "error": null },
      "serverSaved": false },
    { "name": "no server session: local draft, not pending forever",
      "state": { "status": "offline", "editSequence": 3, "acknowledgedSequence": 0, "acknowledgedRevision": null, "currentRevision": null, "error": null },
      "serverSaved": false },
    { "name": "conflict names the revision it lost to",
      "state": { "status": "conflict", "editSequence": 6, "acknowledgedSequence": 4, "acknowledgedRevision": 7, "currentRevision": 9, "error": null },
      "serverSaved": false },
    { "name": "rejected save carries the server reason",
      "state": { "status": "rejected", "editSequence": 6, "acknowledgedSequence": 4, "acknowledgedRevision": 7, "currentRevision": null, "error": "package failed schema validation" },
      "serverSaved": false }
  ],
  "invalid": [
    { "name": "saved before any server ack",
      "state": { "status": "saved", "editSequence": 0, "acknowledgedSequence": 0, "acknowledgedRevision": null, "currentRevision": null, "error": null },
      "codes": ["SAVED_WITHOUT_ACK"] },
    { "name": "saved while a newer edit is unacknowledged",
      "state": { "status": "saved", "editSequence": 5, "acknowledgedSequence": 4, "acknowledgedRevision": 7, "currentRevision": null, "error": null },
      "codes": ["SAVED_WHILE_DIRTY"] },
    { "name": "ack ahead of the edit sequence",
      "state": { "status": "pending", "editSequence": 2, "acknowledgedSequence": 3, "acknowledgedRevision": 7, "currentRevision": null, "error": null },
      "codes": ["SEQUENCE_AHEAD"] },
    { "name": "conflict without the server revision",
      "state": { "status": "conflict", "editSequence": 6, "acknowledgedSequence": 4, "acknowledgedRevision": 7, "currentRevision": null, "error": null },
      "codes": ["CONFLICT_WITHOUT_REVISION"] },
    { "name": "rejected without a reason",
      "state": { "status": "rejected", "editSequence": 6, "acknowledgedSequence": 4, "acknowledgedRevision": 7, "currentRevision": null, "error": null },
      "codes": ["REJECTED_WITHOUT_REASON"] },
    { "name": "error reported on a non-rejected state",
      "state": { "status": "pending", "editSequence": 6, "acknowledgedSequence": 4, "acknowledgedRevision": 7, "currentRevision": null, "error": "stale" },
      "codes": ["ERROR_WITHOUT_REJECTION"] },
    { "name": "renamed status literal",
      "state": { "status": "local", "editSequence": 0, "acknowledgedSequence": 0, "acknowledgedRevision": null, "currentRevision": null, "error": null },
      "codes": ["INVALID_STATUS"] },
    { "name": "revision zero and negative sequence",
      "state": { "status": "pending", "editSequence": -1, "acknowledgedSequence": 0, "acknowledgedRevision": 0, "currentRevision": null, "error": null },
      "codes": ["INVALID_SEQUENCE", "INVALID_REVISION"] },
    { "name": "revision smuggled in as undoable document content",
      "state": { "status": "pending", "editSequence": 1, "acknowledgedSequence": 0, "acknowledgedRevision": null, "currentRevision": null, "error": null, "package": { "revision": 3 } },
