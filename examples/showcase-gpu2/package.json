  "scenes": [
    {
      "id": "s_title",
      "layout": "title",
      "variant": "centered",
      "preferredFrames": 180,
      "copy": {
        "kicker": "Comfyrizz GPU showcase",
        "headline": "How solar power works",
        "sub": "Made with FLUX 3 Klein, LTX-2.5 and SVG on one Google Colab GPU"
      },
      "background": {
        "asset": "a_sunrise",
        "fit": "cover",
        "loop": true,
        "muted": true
      },
      "transitionOut": {
        "type": "fade",
        "frames": 15
      },
      "narration": "How does sunlight become the power in your home? Let's follow the energy, step by step.",
      "narration_asset": "a_narration",
      "narration_duration_frames": 158
    },
    {
      "id": "s_panels",
      "layout": "hero",
      "variant": "split",
      "preferredFrames": 180,
      "copy": {
        "kicker": "Step 1",
        "headline": "Panels catch the light",
        "body": "Silicon cells turn photons into a flow of electrons: direct current."
      },
      "background": {
        "procedural": {
          "pattern": "mesh",
          "seed": 7,
          "palette": [
            "#0b1d2e",
            "#13304a",
            "#ffd166"
          ]
        }
      },
      "foreground": [
        {
          "asset": "a_iso_solar",
          "x": 0.79,
          "y": 0.5,
          "w": 0.4,
          "anim": "slide-in"
        }
      ],
      "transitionOut": {
        "type": "fade",
        "frames": 15
      },
      "narration": "Solar panels are made of silicon cells. When sunlight hits them, it knocks electrons loose and creates a direct current.",
      "narration_asset": "a_narration",
      "narration_duration_frames": 230
    },
    {
      "id": "s_flow",
      "layout": "hero",
      "variant": "full-bleed",
      "preferredFrames": 150,
      "copy": {
        "headline": "Sunlight to home"
      },
      "background": {
        "asset": "a_svg_flow",
        "fit": "cover",
        "loop": true,
        "muted": true
      },
      "transitionOut": {
        "type": "fade",
        "frames": 15
      },
      "narration": "An inverter converts that direct current into alternating current, the kind your home actually uses.",
      "narration_asset": "a_narration",
      "narration_duration_frames": 192
    },
    {
      "id": "s_stat",
      "layout": "stat",
      "preferredFrames": 180,
      "copy": {
        "headline": "Sunlight reaching Earth in",
        "body": "90 min",
        "sub": "roughly matches a year of global energy use (a common estimate)."
      },
      "data": {
        "dataset": "d_solar_day",
        "display": "number"
      },
      "background": {
        "asset": "a_solarfarm",
        "fit": "cover",
        "loop": true,
        "muted": true
      },
      "transitionOut": {
        "type": "fade",
        "frames": 15
      },
      "narration": "And there is plenty of it. The sunlight reaching Earth in about ninety minutes roughly matches a whole year of global energy use.",
      "narration_asset": "a_narration",
      "narration_duration_frames": 234
    },
    {
      "id": "s_battery",
      "layout": "hero",
      "variant": "split",
      "preferredFrames": 165,
      "copy": {
        "kicker": "Step 2",
        "headline": "Store it for the night",
        "body": "A home battery keeps the extra daytime energy for the evening."
      },
      "background": {
        "procedural": {
          "pattern": "grid",
          "seed": 4,
          "palette": [
            "#0b1d2e",
            "#13304a",
            "#ffd166"
          ]
        }
      },
      "foreground": [
        {
          "asset": "a_battery",
          "x": 0.79,
          "y": 0.5,
          "w": 0.4,
          "anim": "slide-in"
        }
      ],
      "transitionOut": {
        "type": "fade",
        "frames": 15
      },
      "narration": "Extra energy from the afternoon charges a home battery, so the lights stay on after sunset.",
      "narration_asset": "a_narration",
      "narration_duration_frames": 186
    },
    {
      "id": "s_chart",
      "layout": "chart",
      "variant": "bar",
      "preferredFrames": 180,
      "copy": {
        "headline": "A day of home solar",
        "sub": "Output peaks around midday.",
        "footnote": "Example data, invented for this demo."
      },
      "data": {
        "dataset": "d_solar_day",
        "display": "bar"
      },
      "background": {
        "asset": "a_ribbons",
        "fit": "cover",
        "loop": true,
        "muted": true
      },
      "transitionOut": {
        "type": "fade",
        "frames": 15
      },
      "narration": "Output follows the sun. It climbs through the morning, peaks around midday, and fades by evening.",
      "narration_asset": "a_narration",
      "narration_duration_frames": 184
    },
    {
      "id": "s_outro",
      "layout": "title",
      "variant": "outro",
      "preferredFrames": 165,
      "copy": {
        "headline": "Made with Comfyrizz",
        "sub": "FLUX 3 Klein · LTX-2.5 · SVG guides · Kokoro"
      },
      "background": {
        "asset": "a_particles",
        "fit": "cover",
        "loop": true,
        "muted": true
      },
      "foreground": [
        {
          "asset": "a_mascot",
          "x": 0.5,
          "y": 0.86,
          "w": 0.2,
          "anim": "fade-in"
        }
      ],
      "narration": "Every image, clip and diagram here came from one short GPU session. Made with Comfyrizz.",
      "narration_asset": "a_narration",
      "narration_duration_frames": 195
    }
