{
  "name": "comfyrizz",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "quality:production": "node scripts/quality/pipeline.mjs",
    "doctor": "node scripts/doctor/doctor.mjs",
    "test": "pnpm run build:libs && pnpm -r --if-present test",
    "test:py": "cd pipeline-py && node ../scripts/py.mjs -m pytest -q",
    "test:scan": "node --test scripts/release-scan.test.mjs && node scripts/release-scan.mjs",
    "test:browser": "pnpm -C apps/web test:e2e",
    "check": "pnpm test && pnpm -C apps/web typecheck && pnpm test:scan",
    "test:all": "pnpm test && pnpm run test:py && pnpm run test:scan",
    "build:libs": "pnpm -r --filter './packages/**' --if-present run build"
  }
}
