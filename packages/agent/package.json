{
  "name": "@comfyrizz/agent",
  "version": "0.0.0",
  "private": true,
  "description": "Comfyrizz agent layer (C3): zod tool validation, repair loop, asset-type router",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "license": "MIT",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "m4": "npm run build && node scripts/m4-live.mjs",
    "m4:two": "npm run build && node scripts/m4-two-providers.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@comfyrizz/llm": "workspace:*",
    "@comfyrizz/schema": "workspace:*",
    "@types/node": "22.10.2",
    "typescript": "5.6.3"
  }
}
