{
  "name": "@comfyrizz/llm",
  "version": "0.0.0",
  "private": true,
  "description": "Comfyrizz LLM layer (C3): OpenAI-compatible streaming adapter, provider presets, capability probe",
  "type": "module",
  "license": "MIT",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist", "src", "scripts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "probe": "npm run build && node scripts/probe.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.6.3"
  }
}
