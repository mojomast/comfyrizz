{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comfyrizz.example/schema/jobs-v1.json",
  "title": "comfyrizz.jobs/v1",
  "description": "The generation jobs the planner writes and pipeline-py executes (SPEC.md 6.4). Written by packages/jobs (planJobs) and read by pipeline-py/comfyrizz_pipeline/runner.py, which validates a jobs.json against this file before submitting anything. Forward-compatible: unknown extra keys on a job are allowed so a newer planner does not break an older runner, but the keys the runner relies on are required.",
  "type": "object",
  "required": ["v", "jobs", "hash"],
  "properties": {
    "v": { "const": 1 },
    "packageId": { "type": ["string", "null"] },
    "revision": { "type": ["integer", "null"] },
    "revisionHash": { "type": ["string", "null"] },
    "fps": { "type": "number", "minimum": 1, "maximum": 240 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "jobs"],
        "properties": {
          "name": { "enum": ["stills", "plates", "upscales", "audio"] },
          "jobs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "batch", "deps", "output", "cacheKey"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "kind": { "enum": ["still", "plate", "upscale", "audio"] },
          "batch": { "enum": ["stills", "plates", "upscales", "audio"] },
          "asset": { "type": "string", "minLength": 1 },
          "scene": { "type": ["string", "null"] },
          "sceneIndex": { "type": ["integer", "null"] },
          "generator": { "enum": ["llm-svg", "flux3-klein", "ltx25", "kokoro"] },
          "workflow": { "type": "string", "minLength": 1, "maxLength": 512 },
          "workflowSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "paramsSource": {
            "type": ["string", "null"],
            "description": "Specialised params map to prefer, e.g. 'upscale' for the finals stage of a plate graph."
          },
          "model": { "type": ["string", "null"] },
          "modelRevision": { "type": ["string", "null"] },
          "deps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "output": { "type": "string", "minLength": 1, "maxLength": 512 },
          "outputKind": { "enum": ["image", "video", "audio"] },
          "cacheKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "params": { "type": "object" },
          "dims": {
            "type": "object",
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "integer", "minimum": 1, "maximum": 32768 },
              "height": { "type": "integer", "minimum": 1, "maximum": 32768 }
            }
          },
          "stage1Dims": {
            "type": "object",
            "required": ["width", "height"],
            "description": "The size the two-stage LTX graph renders stage 1 at: half of dims, which the latent upsampler then doubles back to dims. The params map derives the same number with a {mul: 0.5} target, and GPU test 2 issues 3 and 4 are what happens when the two disagree.",
            "properties": {
              "width": { "type": "number", "minimum": 1, "maximum": 32768 },
              "height": { "type": "number", "minimum": 1, "maximum": 32768 }
            }
          },
          "frames": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "fps": { "type": "number", "minimum": 1, "maximum": 240 },
          "seed": { "type": ["integer", "null"], "minimum": 0, "maximum": 4294967295 },
          "cutout": { "type": "boolean" },
          "inputAsset": { "type": ["string", "null"] },
          "fileInputs": {
            "type": "array",
            "description": "Every parameter whose value is a local file the graph has to be given a server-side name for (a LoadImage-style node). The runner uploads each file to /upload/image and injects the returned name; `from` says where the file is on disk before that. GPU test 2, issue 2: a graph handed the asset id instead fails validation.",
            "items": {
              "type": "object",
              "required": ["param", "from", "path"],
              "properties": {
                "param": { "enum": ["image", "reference", "mask", "audio"] },
                "from": {
                  "enum": ["job", "package"],
                  "description": "job: `path` is relative to the output directory (a dependency's output). package: `path` is relative to the jobs.json directory."
                },
                "job": { "type": ["string", "null"], "description": "the job that produces the file when from=job" },
                "path": { "type": "string", "minLength": 1, "maxLength": 512 }
              }
            }
          },
          "text": { "type": "string" }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset", "reason"],
        "properties": {
          "asset": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "description": "Things the plan did on purpose that a reader should know about, e.g. an i2v source whose aspect does not match its plate, allowed because the caller asked for it.",
      "items": {
        "type": "object",
        "required": ["asset", "code", "message"],
        "properties": {
          "asset": { "type": "string" },
          "code": { "type": "string", "pattern": "^PLAN_[A-Z0-9_]+$" },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
