{
  "name": "@comfyrizz/tts",
  "version": "0.0.0",
  "private": true,
  "description": "Kokoro CPU narration + measured sentence captions (spec 6.8/6.9)",
  "type": "module",
  "license": "MIT",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "py"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js test/*.test.mjs",
    "narrate": "node scripts/narrate.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.6.3"
  }
}
