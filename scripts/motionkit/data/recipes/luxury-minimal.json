{
  "schema": "comfyrizz.recipe/v1",
  "id": "luxury-minimal",
  "label": "Premium brand",
  "taxonomy": { "era": "modernist", "finish": "clean", "energy": "calm", "geometry": "flat", "type": "serif-editorial" },
  "palette": [
    { "role": "background", "hex": "#0e0e0e" },
    { "role": "text", "hex": "#f4efe6" },
    { "role": "accent", "hex": "#c8a96a" },
    { "role": "muted", "hex": "#2a2a2a" }
  ],
  "fonts": { "display": "instrument-serif", "text": "inter" },
  "easing": { "personality": "floaty", "entry": "move", "exit": "exit", "spring": "settle" },
  "entries": ["fadeUp", "maskRise", "pop"],
  "emphasis": ["keyword", "hero"],
  "transitions": { "primary": "fade", "accent": ["blur", "cut"] },
  "storyRecipe": "focus",
  "background": { "pattern": "gradient" },
  "finish": [
    { "id": "grain-fine", "params": { "amount": 0.05, "size": 1 } },
    { "id": "vignette-soft", "params": { "amount": 0.35, "radius": 0.65 } }
  ],
  "rules": {
    "do": ["generous negative space and one gold detail", "slow, quiet fades"],
    "dont": ["busy layouts", "multiple accents"]
  },
  "prompt": "Luxury minimal brand, near-black ground, ivory serif, single gold accent, soft vignette"
}
